# LaTeX build artifacts (paper.pdf at repo root is committed deliberately,
# and so is paper/workshop/paper.pdf — the 4-page workshop submission)
paper/latex/*.aux
paper/latex/*.bbl
paper/latex/*.blg
paper/latex/*.log
paper/latex/*.out
paper/latex/paper.pdf
paper/workshop/*.aux
paper/workshop/*.bbl
paper/workshop/*.blg
paper/workshop/*.log
paper/workshop/*.out
paper/mlsys27/*.aux
paper/mlsys27/*.bbl
paper/mlsys27/*.blg
paper/mlsys27/*.log
paper/mlsys27/*.out
paper/mlsys27/paper.pdf

