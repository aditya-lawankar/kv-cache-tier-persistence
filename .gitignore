# Per-venue bib copies. The single source is paper/shared/references.bib;
# `make sync-bib` copies it next to each paper.tex so every variant builds and
# bundles flat (arXiv and OpenReview both want a self-contained directory).
paper/latex/references.bib
paper/workshop/references.bib
paper/mlsys27/references.bib
